# .env for backend/confs

ENVIRONMENT=production
PORT=8080

CORS_ALLOWED_ORIGINS=https://seu-front.vercel.app,https://seudominio.com

DATABASE_URL=URL-DB
DATABASE_USERNAME=REAPLACE_ME
DATABASE_PASSWORD=REPLACE_ME

INTERNAL_API_SECRET=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME

MAX_MESSAGE_CHARS=12000
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_USER_PER_MINUTE=20
RATE_LIMIT_GLOBAL_PER_MINUTE=60
RATE_LIMIT_BLOCK_SECONDS=300
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
